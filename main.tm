(q0, 0) -> (seek, X, >)
(q0, 1) -> (q-, 1, ^)
(q0, X) -> (q0, X, >)
(q0, Y) -> (check, Y, >)
(q0, _) -> (q+, _, ^)
(seek, 0) -> (seek, 0, >)
(seek, Y) -> (seek, Y, >)
(seek, 1) -> (back, Y, <)
(seek, _) -> (q-, _, ^)
(back, 0) -> (back, 0, <)
(back, 1) -> (back, 1, <)
(back, X) -> (back, X, <)
(back, Y) -> (back, Y, <)
(back, _) -> (q0, _, >)
(check, Y) -> (check, Y, >)
(check, 0) -> (q-, 0, ^)
(check, 1) -> (q-, 1, ^)
(check, _) -> (q+, _, ^)
